:root {
  --bg-gradient-start: #0b0a12;
  --bg-gradient-end: #060509;
  --card-bg: rgba(20, 18, 33, 0.7);
  --card-border: rgba(255, 255, 255, 0.08);
  --card-border-focus: rgba(124, 58, 237, 0.5);
  
  --text-primary: #f3f4f6;
  --text-muted: #9ca3af;
  
  /* Gradientes dos Botões Comerciais */
  --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
  --primary-gradient-hover: linear-gradient(135deg, #4f46e5 0%, #9333ea 50%, #db2777 100%);
  --copy-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);

  --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  
  /* Cantos Arredondados Marcantes */
  --radius-lg: 20px;
  --radius-md: 16px;
  --radius-sm: 10px;
}

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-sans);
  background-color: var(--bg-gradient-start);
  background-image: radial-gradient(at center bottom, #131024 0%, var(--bg-gradient-end) 100%);
  color: var(--text-primary);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* Efeito de Iluminação de Fundo Dinâmico (Aura) */
.ambient-glow {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}
.glow-1 {
  position: absolute;
  width: 500px;
  height: 500px;
  top: -150px;
  left: calc(50% - 250px);
  background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
}
.glow-2 {
  position: absolute;
  width: 600px;
  height: 400px;
  top: 200px;
  right: -100px;
  background: radial-gradient(circle, rgba(236, 72, 153, 0.08) 0%, transparent 70%);
}

.container {
  max-width: 900px;
  margin: 80px auto;
  padding: 0 24px;
  box-sizing: border-box;
}

/* Header Premium */
.badge {
  display: inline-block;
  background: rgba(139, 92, 246, 0.15);
  border: 1px solid rgba(139, 92, 246, 0.3);
  color: #c084fc;
  font-size: 11px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 50px;
  letter-spacing: 0.06em;
  margin-bottom: 16px;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 16px;
}

.logo-icon-wrapper {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(124, 58, 237, 0.3);
}

.header h1 {
  font-size: 38px;
  font-weight: 800;
  margin: 0;
  letter-spacing: -0.03em;
}

.header h1 span {
  background: linear-gradient(to right, #a855f7, #ec4899);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.header p {
  color: var(--text-muted);
  font-size: 16px;
  line-height: 1.6;
  margin: 12px 0 40px 0;
  max-width: 650px;
}

/* Área de Input/Editor - Cantos Redondos e Vidro */
.editor-container-card {
  background: var(--card-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--card-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transition: border-color 0.3s, box-shadow 0.3s;
}

.editor-container-card:focus-within {
  border-color: var(--card-border-focus);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 20px rgba(124, 58, 237, 0.2);
}

.editor-header-bar {
  background: rgba(14, 12, 22, 0.9);
  padding: 14px 20px;
  border-bottom: 1px solid var(--card-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.window-controls {
  display: flex;
  gap: 8px;
}

.control-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}
.control-dot.red { background: #ff5f56; }
.control-dot.yellow { background: #ffbd2e; }
.control-dot.green { background: #27c93f; }

.active-tab {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 6px 16px;
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #cbd5e1;
}

.editor-status-badge {
  font-size: 12px;
  font-weight: 600;
  color: #4ade80;
  display: flex;
  align-items: center;
  gap: 6px;
}

.live-pulse {
  width: 8px;
  height: 8px;
  background: #4ade80;
  border-radius: 50%;
  box-shadow: 0 0 8px #4ade80;
  display: inline-block;
}

textarea {
  width: 100%;
  height: 320px;
  background: transparent;
  border: 0;
  color: #e2e8f0;
  padding: 24px;
  font-family: var(--font-mono);
  font-size: 15px;
  line-height: 1.7;
  resize: vertical;
  box-sizing: border-box;
  outline: none;
}

/* Alinhamento dos Botões e Cli */
.actions-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24px;
  gap: 20px;
  flex-wrap: wrap;
}

/* Botão Moderno com Gradiente Tridimensional */
button[type="submit"] {
  background: var(--primary-gradient);
  border: 0;
  padding: 16px 28px;
  border-radius: var(--radius-md);
  color: white;
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4), inset 0 2px 0 rgba(255, 255, 255, 0.2);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

button[type="submit"]:hover {
  background: var(--primary-gradient-hover);
  transform: translateY(-3px);
  box-shadow: 0 15px 30px rgba(139, 92, 246, 0.5);
}

button[type="submit"]:active {
  transform: translateY(-1px);
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn-kbd {
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 6px;
  padding: 3px 8px;
  font-size: 11px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
}

/* Caixa CLI Lateral */
.cli-hint-box {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--card-border);
  padding: 12px 20px;
  border-radius: var(--radius-md);
  max-width: 440px;
}

.cli-title {
  display: block;
  font-size: 10px;
  font-weight: 800;
  color: #f43f5e;
  letter-spacing: 0.1em;
  margin-bottom: 4px;
}

.cli-code {
  font-family: var(--font-mono);
  color: #93c5fd;
  font-size: 12px;
  word-break: break-all;
}

/* Card de Resultado (Gerado) */
.result-display-card {
  margin-top: 40px;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(5, 150, 105, 0.02) 100%);
  border: 1px solid rgba(16, 185, 129, 0.3);
  padding: 24px;
  border-radius: var(--radius-lg);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
}

.result-success-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
}

.success-icon {
  background: #10b981;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
}

.result-success-header h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: #34d399;
}

.result-success-header p {
  margin: 2px 0 0 0;
  font-size: 13px;
  color: var(--text-muted);
}

.custom-url-field {
  display: flex;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--card-border);
  border-radius: var(--radius-md);
  padding: 8px;
  align-items: center;
  gap: 12px;
}

.link-icon {
  color: #6366f1;
  margin-left: 12px;
}

.custom-url-field input {
  flex: 1;
  background: transparent;
  border: 0;
  color: #a5b4fc;
  font-family: var(--font-mono);
  font-size: 14px;
  outline: none;
}

#copyBtn {
  background: var(--primary-gradient);
  border: 0;
  color: white;
  padding: 12px 24px;
  border-radius: var(--radius-sm);
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s;
}

#copyBtn:hover {
  filter: brightness(1.1);
}

#copyBtn.success-pulse {
  background: var(--copy-gradient);
  box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
}

/* Área inferior de Exemplo */
.showcase-section {
  margin-top: 64px;
}

.showcase-title {
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 16px;
}

.preview-window-card {
  background: #0f0d1a;
  border: 1px solid var(--card-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
}

.preview-header {
  background: #090810;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  border-bottom: 1px solid var(--card-border);
}

.preview-filename {
  font-size: 12px;
  color: var(--text-muted);
  margin-left: 14px;
  font-family: var(--font-mono);
  font-weight: 500;
}

pre {
  margin: 0;
  padding: 24px;
  overflow-x: auto;
  background: transparent !important;
}

code {
  font-family: var(--font-mono) !important;
  font-size: 14px !important;
}
