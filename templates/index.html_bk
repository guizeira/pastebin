<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Pastebin Premium — Compartilhamento Inteligente de Código</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/static/style.css">
  <link rel="stylesheet" href="/static/prism.css">
</head>
<body>

<div class="ambient-glow">
  <div class="glow-1"></div>
  <div class="glow-2"></div>
</div>

<div class="container">
  <header class="header">
    <div class="badge">GFONSECA PASTE v1.0</div>
    <div class="logo-area">
      <div class="logo-icon-wrapper">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 4H4C2.89543 4 2 4.89543 2 6V16C2 17.1046 2.89543 18 4 18H16C17.1046 18 18 17.1046 18 16V6C18 4.89543 17.1046 4 16 4Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 20H20C21.1046 20 22 19.1046 22 18V8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.4"/>
          <path d="M6 9L8 11L6 13" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M11 13H14" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h1>Paste<span>bin</span></h1>
    </div>
    <p>A ferramenta mais rápida e elegante para compartilhar logs, códigos, JSON e scripts instantaneamente.</p>
  </header>

  <main>
    <form id="pasteForm">
      <div class="editor-container-card">
        <div class="editor-header-bar">
          <div class="window-controls">
            <span class="control-dot red"></span>
            <span class="control-dot yellow"></span>
            <span class="control-dot green"></span>
          </div>
          <div class="active-tab">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            novo_paste.txt
          </div>
          <div class="editor-status-badge">
            <span class="live-pulse"></span> Servidor Pronto
          </div>
        </div>
        <textarea id="content" placeholder="// Cole ou digite seu código aqui e gere um link compartilhável premium..." spellcheck="false"></textarea>
      </div>
      
      <div class="actions-wrapper">
        <button type="submit" id="submitBtn">
          <span class="btn-content">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            Criar Link Seguro
          </span>
          <kbd class="btn-kbd">Ctrl + Enter</kbd>
        </button>
        
        <div class="cli-hint-box">
          <span class="cli-title">VIA TERMINAL</span>
          <code class="cli-code">cat file | curl --data-binary @- https://paste.gfonseca.online/paste </code>
        </div>
      </div>
    </form>

    <div class="result-display-card" id="resultCard" style="display:none;">
      <div class="result-success-header">
        <div class="success-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div>
          <h3>Link Gerado com Sucesso!</h3>
          <p>Seu código foi salvo de forma segura na nuvem.</p>
        </div>
      </div>
      <div class="custom-url-field">
        <div class="link-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        </div>
        <input type="text" id="pasteUrl" readonly>
        <button id="copyBtn" onclick="copyToClipboard()">
          <span id="copyBtnText">Copiar Link</span>
        </button>
      </div>
    </div>
  </main>
</div>

<script src="/static/prism.js"></script>
<script src="/static/prism-bash.min.js"></script>
<script src="/static/prism-go.min.js"></script>
<script src="/static/prism-json.min.js"></script>

<script>
const form = document.getElementById("pasteForm");
const textarea = document.getElementById("content");

textarea.addEventListener("keydown", function(e) {
  if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
    e.preventDefault();
    form.requestSubmit();
  }
});

form.addEventListener("submit", async (e) => {
  e.preventDefault();
  const content = textarea.value.trim();
  if(!content) return;

  const btn = document.getElementById("submitBtn");
  btn.disabled = true;
  btn.style.opacity = "0.7";
  btn.innerHTML = '<span>Processando link...</span>';

  try {
    const res = await fetch("/paste", { method: "POST", body: content });
    const text = await res.text();
    
    document.getElementById("resultCard").style.display = "block";
    document.getElementById("pasteUrl").value = text;
    document.getElementById("resultCard").scrollIntoView({ behavior: 'smooth' });
  } catch (err) {
    alert("Ocorreu um erro ao salvar seu paste.");
  } finally {
    btn.disabled = false;
    btn.style.opacity = "1";
    btn.innerHTML = '<span class="btn-content"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>Criar Link Seguro</span><kbd class="btn-kbd">Ctrl + Enter</kbd>';
  }
});

function copyToClipboard() {
  const copyText = document.getElementById("pasteUrl");
  navigator.clipboard.writeText(copyText.value);
  
  const copyBtn = document.getElementById("copyBtn");
  const copyBtnText = document.getElementById("copyBtnText");
  
  copyBtn.classList.add("success-pulse");
  copyBtnText.innerText = "¡Copiado com Sucesso!";
  
  setTimeout(() => {
    copyBtn.classList.remove("success-pulse");
    copyBtnText.innerText = "Copiar Link";
  }, 2500);
}
</script>
</body>
</html>
